+            metric: Metric::Cosine,
+        },
+    )])
+    .unwrap();
+    let w = SegmentWriter::new(vfs.clone(), "seg", &schema, &TokenizerId([0; 32]), 0).unwrap();
+    let meta = w.finalize().unwrap();
